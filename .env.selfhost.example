# Local Docker self-host settings for the v1.6.0 application and container contract.
# README.md and README_EN.md describe every value, its unit, and routine operations.
# HF_TOKEN is read from the current shell by the one-shot model initializer only.

# Local endpoint, NVIDIA GPU index, and enabled model profiles.
MUSIC_TO_MIDI_PORT=7860
GPU_DEVICE_ID=0
MUSIC_TO_MIDI_ENABLED_PROFILES=yourmt3:yptf_moe_multi_nops,piano_transkun

# Upload, queue, disk-reserve, and gateway request limits.
MAX_UPLOAD_BYTES=4294967296
MAX_REQUEST_BODY_SIZE=4GiB
MAX_QUEUED_JOBS=4
MIN_FREE_BYTES=21474836480

# Completed-job retention limits. A zero value disables the matching limit.
RETENTION_DAYS=7
RETENTION_MAX_JOBS=50
RETENTION_MAX_BYTES=107374182400

# Container shared memory and backend log verbosity.
SHM_SIZE=2gb
LOG_LEVEL=info
